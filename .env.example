DJANGO_SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# Hestia'da oluşturduğun Postgres veritabanının bilgileri (host genelde
# localhost/127.0.0.1 olur çünkü web container'ı network_mode: host ile çalışıyor).
# DB_* ayrık değişkenlerini kullan — şifre içinde /, #, ?, | gibi karakterler
# olsa bile burada sorun çıkmaz (tek parça DATABASE_URL string'i bunları
# URL olarak parse etmeye çalışıp kırılabiliyor, DB_PASSWORD ile bu sorun yok).
DB_NAME=<hestia_db_adi>
DB_USER=<hestia_kullanici>
DB_PASSWORD=<hestia_sifre>
DB_HOST=127.0.0.1
DB_PORT=5432
NEXTJS_MASTER_TOKEN=replace-with-long-random-token

# --- Confirmed endpoints (defaults in settings.py already match these) ---
TSS_INSTITUTION_LIST_PATH=/internal-api/search-hospital
TSS_EXTRA_HEADERS={}
TSS_CITY_ID_MODE=plate_code
